# Public hostname only, without https://
SITE_DOMAIN=pet.example.com
APP_VERSION=replace-with-git-commit

NODE_ENV=production
DATABASE_URL=
FIELD_ENCRYPTION_KEY_V1=

PILOT_MODE=enabled
PILOT_HOST=0.0.0.0
PILOT_PORT=3000
PILOT_PUBLIC_ORIGIN=https://pet.example.com
PILOT_AUTH_PEPPER=
PILOT_SESSION_DAYS=7
PILOT_INVITE_HOURS=24
PILOT_TRUST_PROXY=172.30.0.2

S3_ENDPOINT=https://objects.example.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false

# Leave disabled until real WeChat credentials and device acceptance are ready.
WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=

