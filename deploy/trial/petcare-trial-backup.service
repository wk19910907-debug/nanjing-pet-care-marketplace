[Unit]
Description=Pet-care private trial database and object backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/petcare-trial/repo
ExecStart=/bin/bash /opt/petcare-trial/current/scripts/trial-backup.sh
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=600
