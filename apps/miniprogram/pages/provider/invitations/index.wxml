<view class="page"><view class="card"><view>我的服务任务</view><view class="muted">只展示平台分配给当前账号的邀请与任务。</view><view class="danger" wx:if="error">{{error}}</view><button bindtap="reload" loading="{{busy}}" disabled="{{busy}}">刷新任务</button></view><view class="card" wx:if="!busy && !error && tasks.length === 0">暂无任务，等待平台匹配。</view><view class="card" wx:for="{{tasks}}" wx:key="id"><view>{{item.district}} · {{item.label}}</view><view class="muted">{{item.startsAt}}</view><button wx:if="item.invitationId" class="primary" disabled="{{busy}}" data-id="{{item.invitationId}}" bindtap="accept">接受服务邀请</button><button wx:if="item.canOpen" class="primary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="openTask">查看服务任务</button></view></view>
