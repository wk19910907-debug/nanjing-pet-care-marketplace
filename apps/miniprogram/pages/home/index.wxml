<view class="page">
  <view class="hero"><text class="eyebrow">安心宠 · 上门照护</text><text class="title">出门放心，宠物在家也被认真照顾</text><text class="subtitle">上门喂猫 · 上门遛狗，由平台统一匹配服务人员</text></view>
  <view wx:if="{{announcement}}" class="announcement">{{announcement}}</view>
  <view wx:if="{{status==='loading'}}" class="state">正在加载服务信息…</view>
  <view wx:elif="{{status==='error'}}" class="state error"><text>{{errorMessage}}</text><button bindtap="loadCatalog">重新加载</button></view>
  <view wx:else class="content">
    <text class="section-title">预约上门服务</text>
    <view class="service-list"><view wx:for="{{serviceCards}}" wx:key="type" class="service-card"><view><text class="service-title">{{item.title}}</text><text class="service-copy">{{item.summary}}</text></view><text class="price">{{item.price}}</text><button data-service="{{item.type}}" bindtap="startOrder">立即预约</button></view></view>
    <view wx:if="{{!bookingAvailable}}" class="state">当前服务暂未开放</view>
    <view class="districts"><text>当前开放区域</text><text wx:for="{{districts}}" wx:key="code">{{item.name}}</text></view>
    <view class="steps"><text>1 提交预约</text><text>2 平台匹配</text><text>3 上门服务</text><text>4 查看记录</text></view>
  </view>
  <button bindtap="openProviderTasks">服务人员 · 我的任务</button>
</view>
