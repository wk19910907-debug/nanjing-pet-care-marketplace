.page{min-height:100vh;padding:28rpx;background:#fff8f4;color:#392f2d}.hero{padding:46rpx 36rpx;border-radius:32rpx;background:linear-gradient(145deg,#ff8f8f,#ffb1a4);color:#fff;box-shadow:0 18rpx 50rpx #d9686833}.eyebrow,.title,.subtitle,.service-title,.service-copy,.state text,.steps text{display:block}.eyebrow{font-weight:800}.title{margin-top:18rpx;font-size:46rpx;line-height:1.25;font-weight:900}.subtitle{margin-top:18rpx;line-height:1.7;color:#fffdf0}.announcement{margin:22rpx 0 0;padding:20rpx 24rpx;border-radius:18rpx;background:#fff0c9;color:#855515}.content{padding:30rpx 0}.section-title{font-size:34rpx;font-weight:900}.service-list{display:grid;gap:20rpx;margin-top:22rpx}.service-card{padding:28rpx;border-radius:26rpx;background:#fff;box-shadow:0 12rpx 36rpx #6f45451a}.service-title{font-size:32rpx;font-weight:900}.service-copy{margin-top:10rpx;color:#806f6b}.price{display:inline-block;margin-top:22rpx;color:#ff616d;font-size:30rpx;font-weight:900}.service-card button{float:right;margin-top:10rpx;background:#ff7f87;color:#fff;font-size:26rpx}.state{margin-top:24rpx;padding:36rpx;text-align:center;border-radius:22rpx;background:#fff}.state button{margin-top:20rpx;background:#ff7f87;color:#fff}.error{color:#9b3e48}.districts,.steps{margin-top:24rpx;padding:24rpx;border-radius:22rpx;background:#fff}.districts text{display:inline-block;margin:8rpx 16rpx 8rpx 0}.districts text:first-child{display:block;font-weight:800}.steps{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;color:#806f6b}
