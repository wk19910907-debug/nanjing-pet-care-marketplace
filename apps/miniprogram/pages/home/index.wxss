.page{min-height:100vh;padding:28rpx;background:#f6f2e8;color:#173b31}.hero{position:relative;padding:42rpx 34rpx;border-radius:30rpx;background:#173f33;color:#fff}.mode{position:absolute;right:24rpx;top:22rpx;padding:8rpx 16rpx;border:1rpx solid #ffffff66;border-radius:999rpx;font-size:22rpx}.eyebrow,.title,.subtitle{display:block}.eyebrow{color:#e4b95d;font-weight:800}.title{margin-top:18rpx;font-size:48rpx;font-weight:900}.subtitle{margin-top:16rpx;color:#ffffffaa}.roles{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin:24rpx 0}.roles button{margin:0;padding:0;font-size:26rpx;background:#fff}.roles button.active{background:#28634f;color:#fff}.card{padding:30rpx;border-radius:26rpx;background:#fff;box-shadow:0 12rpx 40rpx #173f3312}.section-title{display:block;font-size:34rpx;font-weight:900;margin-bottom:24rpx}.service-switch{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.service-switch button{font-size:25rpx;background:#f2f4ef}.service-switch button.selected{background:#e2a83c}.label{display:block;margin-top:24rpx;font-weight:700}.card input,.card textarea{width:auto;margin-top:10rpx;padding:20rpx;border:1rpx solid #d5ded7;border-radius:14rpx;background:#fafcf9}.card textarea{width:auto;min-height:140rpx}.primary{margin-top:26rpx;background:#e2a83c;color:#173b31;font-weight:900}.order-head{display:flex;justify-content:space-between;gap:20rpx}.status{padding:8rpx 14rpx;border-radius:999rpx;background:#f1dfac;font-size:23rpx}.standalone{display:inline-block;margin:10rpx 0 24rpx}.line{display:block;margin:16rpx 0;color:#5f726a}.report,.provider,.checklist{margin-top:24rpx;padding:24rpx;border-radius:18rpx;background:#f5f8f4}.report text{display:block;margin:8rpx 0}.checklist>view{display:flex;align-items:center;justify-content:space-between;margin:18rpx 0}.empty{padding:38rpx;text-align:center;color:#718078}.reset{margin-top:26rpx;background:#fff;border:1rpx solid #d7ded8;color:#77501a}.safe{display:block;margin:20rpx;text-align:center;color:#7a8781;font-size:22rpx}
