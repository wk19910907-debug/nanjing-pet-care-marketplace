<view class="page"><view class="card"><block wx:for="{{timeline}}" wx:key="label"><view class="{{item.state}}">{{item.label}}</view></block></view>
<button wx:if="{{actions.canCancel}}" bindtap="cancel">取消订单</button><button wx:if="{{actions.canConfirm}}" class="primary" bindtap="confirm">确认完成</button>
<navigator wx:if="{{actions.canDispute || order.status === 'DISPUTED'}}" url="../report/index?id={{orderId}}">查看服务报告与售后</navigator></view>
