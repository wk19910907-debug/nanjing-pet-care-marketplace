<view class="page">
  <view class="card"><text>服务项目</text><picker range="{{['上门喂猫','遛狗']}}"><view>请选择服务、宠物、地址和时间</view></picker></view>
  <view class="card"><block wx:for="{{quoteRows}}" wx:key="label"><view>{{item.label}}　{{item.value}}</view></block></view>
  <button class="primary" bindtap="refreshQuote">获取平台报价</button><button class="primary" loading="{{busy}}" bindtap="submit">确认并支付</button>
</view>
