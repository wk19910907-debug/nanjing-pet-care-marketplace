.heading{display:block;margin-bottom:20rpx;font-size:32rpx;font-weight:900}.service-switch{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.service-switch button{font-size:25rpx;background:#fff1ef}.service-switch button.selected{background:#ff858d;color:#fff}.field{margin-top:18rpx;padding:22rpx;border:1rpx solid #eadbd7;border-radius:16rpx;background:#fffaf8}.quote-row{display:flex;justify-content:space-between;margin:14rpx 0}.secondary{margin-top:18rpx;background:#fff;color:#9a545a;border:1rpx solid #f1b9bd}.primary{margin-top:18rpx;background:#ff7f87}.hint{display:block;margin:20rpx;text-align:center;color:#887975;font-size:23rpx;line-height:1.6}
.section-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.section-row .heading{margin-bottom:0}.text-button{margin:8rpx 0;padding:0 12rpx;background:transparent;color:#b35962;font-size:25rpx;line-height:1.8}.text-button::after{border:0}.note-toggle{text-align:left}.textarea{box-sizing:border-box;width:100%;min-height:140rpx;height:160rpx;font-size:27rpx}.muted{color:#998881;font-size:24rpx}.compact{margin:16rpx 0 0;text-align:left}.time-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:16rpx}.address{word-break:break-all;line-height:1.6}.danger{color:#b44545;font-size:26rpx;line-height:1.6}
