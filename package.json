{
  "name": "nanjing-pet-care-marketplace",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @pet/admin dev --port 43123 --strictPort",
    "build": "pnpm --filter @pet/admin build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:local-start",
    "test:local-start": "node -e \"if(process.platform==='win32'){require('node:child_process').execFileSync('pwsh',['-NoProfile','-File','scripts/start-local-preview.test.ps1'],{stdio:'inherit'})}else{console.log('Windows launcher tests skipped')}\"",
    "test:deploy": "node --test scripts/production-deployment-files.test.mjs",
    "pilot:build": "pnpm --filter @pet/admin build --mode pilot",
    "pilot:start": "pnpm pilot:build && pnpm --filter @pet/api start:pilot",
    "pilot:bootstrap": "pnpm --silent --filter @pet/api bootstrap:pilot",
    "staff:create-admin": "pnpm --silent --filter @pet/api staff:create-admin",
    "test:e2e:live": "node scripts/run-pilot-live-acceptance.mjs",
    "test:live-cleanup": "node --test scripts/pilot-live-state.test.mjs scripts/pilot-live-children.test.mjs",
    "test:s3": "node -e \"process.env.PET_S3_LIVE_TEST='1';require('node:child_process').execSync('pnpm --filter @pet/api exec vitest run tests/s3-live.test.ts',{stdio:'inherit'})\"",
    "local-production:secrets": "pwsh -NoProfile -File scripts/local-production-secrets.ps1",
    "test:local-production:deploy": "node --test scripts/local-production-deployment-files.test.mjs",
    "local-production:start": "pwsh -NoProfile -File scripts/local-production.ps1 start",
    "local-production:status": "pwsh -NoProfile -File scripts/local-production.ps1 status",
    "local-production:stop": "pwsh -NoProfile -File scripts/local-production.ps1 stop",
    "local-production:verify": "pwsh -NoProfile -File scripts/local-production.ps1 verify",
    "test:local-production:verify": "node --test scripts/verify-local-production.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "prisma": "^6.16.1",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
